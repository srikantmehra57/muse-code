{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muse Code",
  "version": "0.1.0",
  "identifier": "com.musecode.desktop",
  "build": {
    "beforeDevCommand": "bash src-tauri/dev-ui.sh",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash src-tauri/build-ui.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Muse Code",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0c0c0e",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "externalBin": ["binaries/muse-node"],
    "resources": {
      "../../../packages/muse-bridge/dist/index.js": "muse-bridge/index.js"
    }
  }
}
